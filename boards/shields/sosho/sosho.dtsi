#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/behaviors.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include "sosho-layouts.dtsi"

/*&uart0 { status = "disabled"; };*/
&i2c0  { status = "disabled"; };
&i2c1  { status = "disabled"; };

/* NFC 用のピン（P0.09・P0.10）を普通のピンとして使う（列 3・列 5 のキー）。
   Zephyr 4.1 で非推奨になった CONFIG_NFCT_PINS_AS_GPIOS の後継の書き方 */
&uicr {
    nfct-pins-as-gpios;
};

/ {
	/* キー入力に関する設定 */
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)     RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)     RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)     RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1)                 RC(3,4) RC(3,5)     RC(3,6) RC(3,7)                 RC(3,10) RC(3,11)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

	/* エンコーダに関する設定 */
    right_encoder: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        steps = <96>;
        status = "disabled";
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        steps = <96>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <24>;
    };

	/* L側のspi入力 */
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        glidepoint_split: glidepoint_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
			status = "disabled";
        };

        trackball_split: trackball_split@1 {
            compatible = "zmk,input-split";
            reg = <1>;
			status = "disabled";
        };
    };

	/* spiをinputとして受け取るところ */
    glidepoint_split_listener: glidepoint_split_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
		device = <&glidepoint_split>;
    };

    glidepoint_listener: glidepoint_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&glidepoint>;
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball>;
    };

    trackball_split_listener: trackball_split_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
		device = <&trackball_split>;
    };

	/* zmk-rgbled-widgetのおまじない */
    aliases {
        led-red = &led0;
        led-green = &led1;
        led-blue = &led2;
    };

    leds {
        status = "okay";
    };

	/* 充電 IC（BQ25101）の CHG 信号。充電中は Low（XIAO の赤い充電 LED と同じ線）。
	   src/charging_led.c が読むだけで、充電電流を切り替える P0.13 には触らない。
	   pwms は充電中の LED のフェード用（赤・緑。下の &pwm1） */
    zephyr,user {
        chg-gpios = <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        pwms = <&pwm1 0 PWM_MSEC(1) PWM_POLARITY_INVERTED>,
               <&pwm1 1 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
        pwm-names = "red", "green";
    };

	/* ボード定義の PWM の LED（&pwm0 を使う）は使わない。下の &pwm0 の注意を参照 */
    pwmleds {
        status = "disabled";
    };
};

&pinctrl {
    /* トラックパッドの配線設定 */
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                    <NRF_PSEL(SPIM_MISO, 1, 14)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                    <NRF_PSEL(SPIM_MISO, 1, 14)>;
            low-power-enable;
        };
    };
    /* トラックボールの配線設定 */
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 14)>,
                    <NRF_PSEL(SPIM_MISO, 1, 14)>;
        };
    };
    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 14)>,
                    <NRF_PSEL(SPIM_MISO, 1, 14)>;
            low-power-enable;
        };
    };
    /* 状態表示の LED（赤 P0.26・緑 P0.30）の PWM。LED は Low で点くので反転する */
    pwm1_led_default: pwm1_led_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 26)>,
                    <NRF_PSEL(PWM_OUT1, 0, 30)>;
            nordic,invert;
        };
    };
    pwm1_led_sleep: pwm1_led_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 26)>,
                    <NRF_PSEL(PWM_OUT1, 0, 30)>;
            low-power-enable;
        };
    };
};

/* ボード定義の &pwm0 は出力を P0.17（充電 IC の CHG）に割り当てている。
   PWM のドライバを入れると CHG の線を駆動してしまうので、必ず無効にしておく */
&pwm0 {
    status = "disabled";
};

/* 状態表示の LED の PWM（充電中のフェード）。止めている間は widget が GPIO で点け消しする */
&pwm1 {
    status = "okay";
    pinctrl-0 = <&pwm1_led_default>;
    pinctrl-1 = <&pwm1_led_sleep>;
    pinctrl-names = "default", "sleep";
};


/* トラックパッドの配線設定 */
&spi0 {
    status = "disabled";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
    glidepoint: glidepoint@0 {
        status = "disabled";
        compatible = "cirque,pinnacle";
        reg = <0>;
        spi-max-frequency = <500000>;
        data-ready-gpios = <&gpio1 7 (GPIO_ACTIVE_HIGH)>;
        /* Setting a higher sensitivity causes issues on bluetooth */
        sensitivity = "1x";
    };
};

/* トラックボールの配線設定 */
#include <zephyr/dt-bindings/input/input-event-codes.h>
&spi1 {
    status = "disabled";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 3 GPIO_ACTIVE_LOW>; // nCS

    trackball: trackball@0 {
        status = "disabled";
        compatible = "pixart,pmw3610-alt";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio1 7 (GPIO_ACTIVE_HIGH)>;      // Sample-LOW PRODUCT-HIGH
        cpi = <600>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_Y>;
        y-input-code = <INPUT_REL_X>;
    };
};
